# ==============================================================================
# Synthetic Data Studio - Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and populate with your credentials.
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Primary LLM Provider Configuration (OpenAI Compatible)
# ------------------------------------------------------------------------------

# Option A: Google Gemini (Recommended / Default)
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Option B: OpenAI
# LLM_API_KEY=sk-proj-your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Option C: OpenRouter (DeepSeek, Claude, Llama 3, etc.)
# LLM_API_KEY=sk-or-v1-your_openrouter_api_key
# LLM_MODEL=deepseek/deepseek-chat
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Option D: Local Ollama (No API Key Required)
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 2. DataScout Dataset Discovery Integrations (Optional)
# ------------------------------------------------------------------------------

# Kaggle API Token (Allows searching and fetching datasets from Kaggle)
# Obtain from: https://www.kaggle.com/settings -> "Create New Token"
KAGGLE_API_TOKEN=

# Hugging Face Access Token (Increases rate limits & enables private dataset access)
# Obtain from: https://huggingface.co/settings/tokens
HF_TOKEN=
